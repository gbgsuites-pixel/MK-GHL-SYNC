# =============================================================================
# Mary Kay InTouch — GoHighLevel Sync Server
# Environment Configuration
# =============================================================================

# Server port (Render sets this automatically)
PORT=3000

# API Secret Key — protects all endpoints. Set this in Render environment variables.
API_SECRET_KEY=my-local-test-key

# Path to the clients configuration JSON file
CONFIG_PATH=./config/clients.json

# Puppeteer executable path (for Render Docker deployment)
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# Logging level: debug, info, warn, error
LOG_LEVEL=info

# GHL Sync Chunk Size — number of contacts processed per GHL API batch
GHL_CHUNK_SIZE=50

# Protected-field preflight behavior. Leave false during the Supabase cutover
# to use a complete stored mapping when the GHL custom-field read endpoint is
# unavailable. Set true after confirming the GHL token has custom-field read
# access to every location to fail closed on any live mapping mismatch.
STRICT_GHL_FIELD_PREFLIGHT=false

# Session TTL in hours (default 23)
SESSION_TTL_HOURS=23

# Mary Kay InTouch base URLs (do not change unless MK changes their domain)
MK_BASE_URL=https://mk.marykayintouch.com
APPS_BASE_URL=https://apps.marykayintouch.com
